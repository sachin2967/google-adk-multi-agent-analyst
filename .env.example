# Natural-language agent calls use a local Ollama model; direct metrics work without it.
ANALYST_MODEL=ollama_chat/qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434
APP_ENV=local
ANALYST_API_KEY=
# For a hosted Gemini run, set ANALYST_MODEL to the exact supported model ID.
# Configure GOOGLE_API_KEY outside Git and verify Developer Program billing first.
# GOOGLE_API_KEY=
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
